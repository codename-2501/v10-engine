{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "engine/skills/specs/schemas/routing_config.json",
  "title": "Routing Config",
  "type": "object",
  "required": ["framework", "routes"],
  "additionalProperties": true,
  "properties": {
    "framework": {
      "type": "string",
      "enum": ["react-router", "next-app", "next-pages", "nuxt", "vue-router", "expo-router", "react-native-navigation"]
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path"],
        "properties": {
          "path": {"type": "string", "pattern": "^/"},
          "screen_id": {
            "type": "string",
            "pattern": "^(SC-[A-Z]{2,4}-[0-9]{3,4}|SCR-[0-9]{3,4})$"
          },
          "page_slug": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "auth_required": {"type": "boolean"},
          "layout": {"type": "string"},
          "children": {"type": "array"}
        }
      }
    },
    "guards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {"type": "string"},
          "applies_to": {"type": "array", "items": {"type": "string"}},
          "redirect": {"type": "string"}
        }
      }
    },
    "fallback": {
      "type": "object",
      "properties": {
        "404": {"type": "string"},
        "500": {"type": "string"}
      }
    }
  }
}
