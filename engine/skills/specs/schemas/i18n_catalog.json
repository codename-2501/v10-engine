{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "engine/skills/specs/schemas/i18n_catalog.json",
  "title": "i18n Catalog",
  "type": "object",
  "required": ["default_locale", "supported_locales", "messages"],
  "additionalProperties": true,
  "properties": {
    "default_locale": {
      "type": "string",
      "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
    },
    "supported_locales": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
      }
    },
    "namespaces": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
    },
    "messages": {
      "type": "object",
      "patternProperties": {
        "^[a-z]{2}(-[A-Z]{2})?$": {
          "type": "object"
        }
      },
      "additionalProperties": false
    }
  }
}
