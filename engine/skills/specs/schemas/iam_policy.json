{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "engine/skills/specs/schemas/iam_policy.json",
  "title": "IAM / RBAC Policy",
  "type": "object",
  "required": ["roles", "permissions"],
  "additionalProperties": true,
  "properties": {
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "description": {"type": "string"},
          "inherits": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    },
    "permissions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["resource", "actions"],
        "properties": {
          "resource": {"type": "string"},
          "actions": {
            "type": "array",
            "items": {
              "enum": ["create", "read", "update", "delete", "list", "execute"]
            },
            "minItems": 1
          },
          "roles": {
            "type": "array",
            "items": {"type": "string"}
          },
          "conditions": {"type": "object"}
        }
      }
    }
  }
}
