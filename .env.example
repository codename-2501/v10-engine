# AI SI 매뉴팩처링 플랫폼 v8 — 환경변수 예시
# 이 파일을 .env 로 복사 후 값을 채워서 사용
# cp .env.example .env

# ── 실행 환경 ─────────────────────────────────────────────────
ENV=production          # production | development
DATABASE_URL=sqlite:///platform.db
# PostgreSQL 사용 시:
# DATABASE_URL=postgresql://user:password@localhost:5432/platform_db

# ── 암호화 키 (AES-256-GCM) ───────────────────────────────────
# python -c "from engine.security.crypto import AES256GCM; print(AES256GCM.generate_key())"
ENCRYPTION_KEY=your_base64_encoded_32_byte_key_here

# ── AI Provider API 키 ────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-...
OPENAI_API_KEY=sk-proj-...
GOOGLE_APPLICATION_CREDENTIALS=path/to/service_account.json

# ── 서버 설정 ─────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
WORKERS=1               # SQLite는 반드시 1. PostgreSQL 사용 시 늘릴 수 있음.
LOG_LEVEL=info

# ── JWT 설정 ──────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here_min_32_chars
JWT_EXPIRE_HOURS=24
